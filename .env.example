# Mastra Factory environment.
# Copied to .env by `npm create factory`; every value is optional —
# features light up as their variables are set (see README.md).
# Validation source of truth: .env.schema (varlock).
# Which sandbox runs session commands: docker (a per-session container on this
# host's engine, selected ahead of every cloud provider) or local (this machine,
# as the server process, even with cloud credentials configured). Separate from
# SANDBOX_PROVIDER, which selects PlatformSandbox's cloud backend (e2b or railway).
# Unset keeps automatic provider selection: Platform, then direct E2B, then local.
# See the Sandbox provider section below and sandbox/README.md.
# FACTORY_SANDBOX_PROVIDER=

# ---------------------------------------------------------------------------
# Browser-facing origin
# ---------------------------------------------------------------------------

# The public origin the browser uses to reach the app. This is the single
# source of truth for ALL OAuth callback URLs:
#   - GitHub:  <MASTRACODE_PUBLIC_URL>/auth/github/callback
#   - Linear:  <MASTRACODE_PUBLIC_URL>/auth/linear/callback
# Self-managed sign-in (BETTER_AUTH_SECRET below) registers no callback with
# anyone: it serves its own endpoints under <MASTRACODE_PUBLIC_URL>/auth/api and
# this value is the origin it issues session cookies for. The hosted-login
# /auth/login + /auth/callback pair belongs to the platform-backed default
# provider, so it exists whenever that provider is installed — both when
# MASTRA_SHARED_API_URL is set and when no sign-in is configured at all.
# Defaults to http://localhost:4111 (the Factory server, which also serves
# the UI) when unset. When developing with a separate Vite dev server (:5173
# proxying to the API on :4111), set this to the SPA origin
# (http://localhost:5173). Restart the dev server after changing this —
# varlock re-reads .env on each start.
# MASTRACODE_PUBLIC_URL=
# Public origin Slack/channels must reach for OAuth callbacks and deep links.
# Must be publicly routable (e.g. a tunnel). Kept separate from
# MASTRACODE_PUBLIC_URL so auth can run on localhost (the hosted platform only
# allow-lists localhost for the auth redirect) while Slack still reaches this
# machine via the tunnel. Falls back to MASTRACODE_PUBLIC_URL when unset.
# MASTRACODE_CHANNELS_PUBLIC_URL=
# Slack request signing secret (Basic Information → App Credentials). This is
# the switch for Slack as a whole: unset → no Slack integration is constructed
# and the Connections page reports Slack as not set up. Also the last-resort
# state-signer secret (see GITHUB_APP_WEBHOOK_SECRET below), so a Slack-only
# deployment has a signer that survives a restart.
# SLACK_APP_SIGNING_SECRET=
# Slack bot token (OAuth & Permissions → Bot User OAuth Token, starts xoxb-).
# Lets the app post messages and open DMs; without it Slack can reach the app
# but the app cannot answer.
# SLACK_APP_BOT_TOKEN=
# Slack app OAuth client credentials (Basic Information → App Credentials).
# Enable the web-initiated "Sign in with Slack" (OIDC) account-linking flow;
# unset → linking only starts from the Slack-side Connect card. The Slack app
# must list MASTRACODE_CHANNELS_PUBLIC_URL + /connect/slack/oidc/callback as an
# OAuth redirect URL (Slack requires HTTPS, so locally that's the tunnel).
# SLACK_APP_CLIENT_ID=
# SLACK_APP_CLIENT_SECRET=
# Comma-separated origins allowed for credentialed cross-origin requests; only
# needed when the SPA is hosted separately from the API server.
# MASTRACODE_ALLOWED_ORIGINS=
# Explicit path to the built SPA (a dir containing index.html). In production
# the built SPA is served same-origin at `/` by the API server. It is
# auto-located: MASTRACODE_UI_DIST, then `ui/` next to the server bundle
# (mastra build copies the vite output there via the Mastra entry's public/
# dir), then `src/mastra/public/ui` under cwd.
# MASTRACODE_UI_DIST=

# ---------------------------------------------------------------------------
# Stored credential encryption
# ---------------------------------------------------------------------------

# Required whenever authentication is enabled. Base64-encoded 32-byte AES key
# used to encrypt model-provider keys, custom-provider API keys, GitHub PATs,
# and integration OAuth tokens before they are persisted. Generate with:
#   openssl rand -base64 32
# Keep this stable across deploys; losing it makes stored credentials unreadable.
# FACTORY_CREDENTIAL_ENCRYPTION_KEY=
# Identifier recorded with new ciphertext. Change this when rotating the key.
FACTORY_CREDENTIAL_ENCRYPTION_KEY_ID=v1
# Optional JSON object mapping previous key ids to base64-encoded 32-byte keys.
# Keep old keys here during rotation; rows are re-encrypted with the primary key
# when read or when storage initializes. Example: {"v1":"<old-base64-key>"}
# FACTORY_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=

# ---------------------------------------------------------------------------
# Mastra platform auth (highest precedence)
# When MASTRA_SHARED_API_URL is set, this instance defers all identity to a
# Mastra platform API (e.g. https://platform.mastra.ai/v1). No sign-in secret is
# needed here — the platform owns identity. Takes precedence over
# BETTER_AUTH_SECRET below, so a deployment that sets this var never falls back
# to its own credentials by accident; when both are set the server logs that the
# secret is being ignored.
# ---------------------------------------------------------------------------

# Base URL of the Mastra platform API's `/v1` root (e.g.
# https://platform.mastra.ai/v1 or http://localhost:3010/v1 for local dev
# against a locally-running platform API). Also used by zero-argument
# PlatformGithubIntegration and PlatformLinearIntegration.
# MASTRA_SHARED_API_URL=
# Optional: pin this deployment to a specific platform organization. Members
# are served in this org whatever org their session cookie is on; users whose
# memberships don't include it are rejected. Leave unset for
# multi-org deployments. Only honored on the platform-deferred auth path;
# the self-managed Better Auth path below does not enforce it.
# MASTRA_ORGANIZATION_ID=
# Optional: parent cookie domain (e.g. `.mastra.cloud`) for the sealed
# session cookie this deployment sets after callback. Auto-detected from
# MASTRA_SHARED_API_URL for `*.mastra.ai` hosts; otherwise the cookie is
# host-only (fine for localhost dev on different ports). Only applies to the
# platform-deferred auth path, not the self-managed Better Auth path below.
# MASTRA_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Mastra Platform integrations and sandbox
# PlatformGithubIntegration and PlatformLinearIntegration are zero-argument
# integrations. They use MASTRA_SHARED_API_URL and a Platform credential:
# MASTRA_PLATFORM_ACCESS_TOKEN (checked first) or MASTRA_PLATFORM_SECRET_KEY.
# PlatformSandbox is selected automatically only when
# MASTRA_PLATFORM_ACCESS_TOKEN plus MASTRA_PROJECT_ID and
# MASTRA_ENVIRONMENT_ID are all set.
# ---------------------------------------------------------------------------

# Credential Mastra Platform injects into deployed projects; locally set your
# platform org key here. The only credential the sandbox path reads.
# MASTRA_PLATFORM_ACCESS_TOKEN=
# Org secret key written by project scaffolding. Used by the Platform
# integrations when MASTRA_PLATFORM_ACCESS_TOKEN is unset; does not select
# PlatformSandbox.
# MASTRA_PLATFORM_SECRET_KEY=
# Required for PlatformSandbox auto-selection.
# MASTRA_PROJECT_ID=
# Required for PlatformSandbox auto-selection.
# MASTRA_ENVIRONMENT_ID=
# Optional PlatformSandbox workspace proxy URL. Defaults to the hosted proxy.
# MASTRA_WORKSPACE_PROXY_URL=
# Which sandbox backend the workspace proxy should provision: "railway" or
# "e2b". Unset keeps the proxy's legacy (Railway) routes.
# SANDBOX_PROVIDER=
# GitHub event polling is enabled by default. Set false to disable it.
# (Bare true/false are listed alongside the quoted forms because varlock
# coerces unquoted booleans before enum validation.)
# MASTRA_PLATFORM_GITHUB_POLLING_ENABLED=
# Optional positive polling interval in milliseconds. Defaults to 5000.
# MASTRA_PLATFORM_GITHUB_POLLING_INTERVAL_MS=
# Merged-PR reconcile sweep is enabled by default (runs even when event
# polling is disabled). Set false to disable it.
# MASTRA_PLATFORM_GITHUB_RECONCILE_ENABLED=

# ---------------------------------------------------------------------------
# Self-managed auth (Better Auth)
# This deployment's own sign-in, with no external identity provider in the
# path. When BETTER_AUTH_SECRET is set (and MASTRA_SHARED_API_URL is not),
# every route requires a signed-in user, the email/password form appears on the
# sign-in page, and sessions are issued by this server. Accounts, sessions and
# organizations live in this deployment's own database — the same DATABASE_URL
# as the app tables below, or the local libSQL file in bare local dev — and the
# tables are created on first use, so there is no migration step to run. That
# creation is DDL issued on the first sign-in request, so the role in
# DATABASE_URL needs table-creation rights then, not just at deploy time; a
# role without them leaves sign-in unavailable with the reason only in the
# server log, which reads like a bad secret.
# Every signed-in user then gets a personal organization, which is what
# org-scoped features (GitHub connect, projects) need. That bootstrap is
# best-effort: a failure is logged and the user is left without one rather
# than being turned away, so treat a missing organization as a failed
# bootstrap to investigate.
# Registration is CLOSED on this path: sign-up is disabled in committed code
# (`signUpEnabled: false` in src/mastra/index.ts), so the sign-in page offers
# no account creation and POST /auth/api/sign-up/email is refused with 400
# EMAIL_PASSWORD_SIGN_UP_DISABLED. There is deliberately no key here that
# reopens it — an account is made by opening that window on purpose and
# closing it again: set the field to true, let the server restart, create the
# one account, set it back to false and let it restart again. README "Start
# the Factory Server" step 3 is the full procedure. Keep the deployment on
# loopback (MASTRA_HOST=127.0.0.1) for as long as the window is open, and do
# not expose a fresh deployment publicly before your own account exists and
# sign-up is closed again.
# Setting MASTRACODE_ALLOWED_ORIGINS (above) puts this path in cross-site mode:
# session cookies are then issued `SameSite=None; Secure`, which browsers drop
# over plain HTTP — so allowed origins require an https MASTRACODE_PUBLIC_URL,
# or sign-in appears to succeed and no session is ever kept.
# Unset, the server falls back to MastraAuthStudio, the platform-backed default
# provider, which verifies identity against https://platform.mastra.ai — a
# third party in the sign-in path. A typo in the key name lands there silently.
# ---------------------------------------------------------------------------

# Secret used to sign this deployment's session cookies. 32+ characters.
# Generate with:
#   openssl rand -base64 32
# Keep it stable across deploys and across replicas: changing it invalidates
# every session, and two replicas with different values cannot read each
# other's cookies. Blank or unset means "self-managed sign-in is not
# configured" — the server does not fail to boot, it falls through.
# BETTER_AUTH_SECRET=

# ---------------------------------------------------------------------------
# WorkOS (legacy)
# These keys no longer select an auth provider — self-managed sign-in is Better
# Auth above. They remain listed because WORKOS_COOKIE_PASSWORD is still one of
# the values the OAuth/link `state` signer falls back to (see
# GITHUB_APP_WEBHOOK_SECRET below), so a deployment that already set it keeps a
# signer that survives a restart. Setting the API key and client id has no
# effect on sign-in.
# ---------------------------------------------------------------------------

# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# Unused: nothing reads this key now. The platform-backed default provider's
# own /auth/callback derives its redirect from MASTRACODE_PUBLIC_URL, not from
# here.
# WORKOS_REDIRECT_URI=
# Optional 32+ char secret. Read only as a `state`-signer fallback (above).
# WORKOS_COOKIE_PASSWORD=
# Unused. Nothing in the server or the installed packages reads this key: the
# personal-organization bootstrap is now unconditional and is performed by the
# Better Auth provider on first authenticated use, so there is nothing left to
# switch off here.
# (Bare 0/1 are listed alongside the quoted forms because varlock coerces
# unquoted numbers before enum validation.)
# MASTRACODE_BOOTSTRAP_PERSONAL_ORG=

# ---------------------------------------------------------------------------
# Application database
# Optional Postgres database for Mastra agent state (threads, messages,
# memory, recall vectors) and Factory application data. When unset in local
# development, all Factory data uses a local libSQL file instead. To run
# Postgres locally, start the docker-compose.yml service with `npm run db:up`
# and point this at it:
# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:54329/<POSTGRES_DB>
# (see the Local Postgres section below).
# On the Mastra platform this is populated automatically by the managed
# env-var sync when a Neon (or other) database is attached to the project.
# ---------------------------------------------------------------------------

# DATABASE_URL=
# Deprecated alias for DATABASE_URL. Honored as a fallback for existing
# checkouts; new setups should use DATABASE_URL instead.
# APP_DATABASE_URL=

# Overrides the libSQL file path used when no database URL is set. Unset, the
# file resolves to the shared mastracode app-data directory — the same
# `mastra.db` the Mastra Code CLI opens, so running both at once yields
# `SQLITE_BUSY: database is locked`. Point this at a path inside the package to
# give the web dev server its own database.
# MASTRA_DB_PATH=

# ---------------------------------------------------------------------------
# Local Postgres (docker-compose.yml)
# Read by Docker Compose, not by the server: they parameterize the app-db
# service. Compose interpolates the file on every command, so all of them
# (`npm run db:up`, `npm run db:down`, ps, logs, config) abort until
# POSTGRES_PASSWORD is set. README.md describes how to choose the values.
# ---------------------------------------------------------------------------

# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=

# ---------------------------------------------------------------------------
# Container engine (ops/README.md)
# Colima creates and activates a docker context for its socket, so the CLI and
# Compose usually resolve it without this variable. DOCKER_HOST covers the
# consumers that do not read docker contexts — dockerode, which the server uses
# for the docker sandbox provider, and any process launchd starts — and it
# overrides the context when set. ops/README.md describes the value and how to
# obtain it. Write the path out in full here: nothing expands $HOME in .env.
# ---------------------------------------------------------------------------

# DOCKER_HOST=

# ---------------------------------------------------------------------------
# GitHub projects
# When all required GitHub App variables are set, signed-in users can install
# the GitHub App, pick repositories, and turn each repository into a project.
# Data uses local libSQL during local development or Postgres when DATABASE_URL
# is set.
#
# The GitHub callback URL is always derived from MASTRACODE_PUBLIC_URL
# (/auth/github/callback) — there is no separate redirect env var. Register
# this exact URL in both the GitHub App's "Callback URL" and "Setup URL"
# fields (Settings → GitHub Apps → your app → General).
# ---------------------------------------------------------------------------

# GITHUB_APP_ID=
# PEM contents, e.g. "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=
# Stable secret for signing GitHub OAuth/install state and verifying webhooks.
# A configured GitHub integration requires either this value or
# WORKOS_COOKIE_PASSWORD, even when webhooks are disabled. Slack falls back to
# SLACK_APP_SIGNING_SECRET when neither is set, so a Slack-only deployment
# boots without a GitHub App.
# GITHUB_APP_WEBHOOK_SECRET=
# Merged-PR reconcile sweep is enabled by default. It is the only writer of
# merge state when GitHub cannot reach this deployment's webhook endpoint
# (private network, local dev). Set false to disable it.
# (Bare true/false are listed alongside the quoted forms because varlock
# coerces unquoted booleans before enum validation.)
# MASTRACODE_GITHUB_RECONCILE_ENABLED=
# Optional positive sweep interval in milliseconds. Defaults to 300000 (5min).
# MASTRACODE_GITHUB_RECONCILE_INTERVAL_MS=

# ---------------------------------------------------------------------------
# Model providers
# API keys for the agent's model providers. Loaded from this file by the
# code SDK on boot; keys can also be added/managed at runtime from the
# web UI (Settings › Models). At least one provider key (or a stored
# credential) is needed for agents to run.
# ---------------------------------------------------------------------------

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Linear intake
# When BOTH Linear OAuth vars are set AND web auth is enabled AND the app
# database is configured, orgs can connect a Linear workspace and pull issues
# into the intake board. Setting only one of the two vars is a boot error
# (all-or-nothing per integration).
#
# The Linear OAuth callback URL is derived from MASTRACODE_PUBLIC_URL
# (/auth/linear/callback) — register that exact URL in the Linear OAuth app.
# ---------------------------------------------------------------------------

# Keep this dependency one-way: reciprocal @required annotations form a
# Varlock dependency cycle. Runtime envGroup validation enforces the other
# direction and reports a partial Linear configuration as a boot error.
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Sandbox provider (repo materialization)
# GitHub-backed projects are materialized (cloned) into a sandbox on open.
# FACTORY_SANDBOX_PROVIDER (top of this file) selects it. `docker` wins ahead of
# every cloud provider and runs each session in its own container on the engine
# DOCKER_HOST points at. `local` runs git directly on the server host. With the
# key unset the provider is selected automatically: when this deployment is
# configured for Mastra Platform (see MASTRA_PLATFORM_SECRET_KEY /
# MASTRA_PROJECT_ID / MASTRA_ENVIRONMENT_ID above) each project gets an isolated
# cloud VM, then direct E2B, otherwise the LOCAL provider — so repos can always
# be opened with no extra wiring. The sandbox must have `git` and `gh` (the
# GitHub CLI) and outbound access to github.com; `gh` is only needed to open
# pull requests.
#
# sandbox/README.md states what each FACTORY_SANDBOX_* value and
# MASTRACODE_SANDBOX_WORKDIR must contain and how to choose it.
#
# WARNING: the local provider has NO tenant isolation — every project's git
# runs as the server process on the shared host filesystem. It is intended for
# single-user local development only; configure Mastra Platform for shared
# multi-tenant deployments.
# ---------------------------------------------------------------------------

# Container image each docker-provider session runs in. No default: the docker
# provider refuses to start a session until this names an image.
# FACTORY_SANDBOX_IMAGE=
# Hard memory ceiling for one docker-provider session container, in whole
# gibibytes. A value that is not a positive whole number falls back to the
# default, 10.
# FACTORY_SANDBOX_MEMORY_GIB=
# Hard CPU ceiling for one docker-provider session container, in whole cores.
# A value that is not a positive whole number falls back to the default, 4.
# FACTORY_SANDBOX_CPUS=
# Checkout base inside docker-provider sandboxes (one directory per repo, named
# after the repo alone — no owner segment), default /workspace. Only the docker
# provider reads it: LocalSandbox checks out under MASTRACODE_LOCAL_SANDBOX_ROOT
# on the host, and the Platform and E2B providers clone into the VM's own home
# directory.
MASTRACODE_SANDBOX_WORKDIR=/workspace
# Host root for LocalSandbox checkouts (default ~/.mastracode/web/sandboxes);
# only used by the local provider.
# MASTRACODE_LOCAL_SANDBOX_ROOT=
# Maximum docker-provider session containers this server process runs at once.
# A request for one more is refused and the error names this key; a session that
# already has a container is reattaching and is admitted even at the cap. A
# value outside the pattern `.env.schema` declares fails `varlock load`, so
# `npm start` refuses to boot rather than falling back; blank and 0 are the
# values that pass and reach the code, where both fall back to the default, 3.
# No value disables the cap. The count is per server process, so containers left
# running by an earlier process are not counted. Only the docker provider is
# capped.
# MASTRACODE_MAX_SANDBOXES=

# ---------------------------------------------------------------------------
# Multi-replica deployment
# ---------------------------------------------------------------------------

# Set to 0 to disable the Postgres advisory-lock layer used to serialize
# per-(project,user) git write operations across replicas. When enabled
# (default), it requires DATABASE_URL. Use 0 for single-process local dev.
# MASTRACODE_DISTRIBUTED_LOCK=

# ---------------------------------------------------------------------------
# Local development tools
# ---------------------------------------------------------------------------

# Set to exactly "true" to load react-grab in the Vite development server;
# empty means off.
# VITE_REACT_GRAB=
