# Mastra Factory environment. Copy to .env and fill in what you use.
# src/mastra/config/env.ts lists, validates and documents every key (same order).
# A blank value counts as unset. Details: README.md and each subject's README.
#
# Priority: values load first from AWS Parameter Store (when
# FACTORY_SSM_PARAMETER_PATH is set); a non-blank value in this file overrides them.

# ===========================================================================
# 1. SYSTEM KEYS — keep these in .env
# ===========================================================================

# --- AWS Parameter Store (README.md) — must be here, never in Parameter Store
# Path that holds the additional keys, e.g. /mastra-factory. Blank = no AWS call.
FACTORY_SSM_PARAMETER_PATH=
# Region of the path, e.g. eu-central-1. Required when the path is set.
AWS_SECRETS_MANAGER_REGION=
# Access key pair for the path. Set both or neither (neither = AWS default credentials).
AWS_SECRETS_MANAGER_ACCESS_KEY_ID=
AWS_SECRETS_MANAGER_SECRET_ACCESS_KEY=

# --- Server (ops/README.md)
# Keep the literal 127.0.0.1: blank binds every interface, and localhost is not equivalent.
MASTRA_HOST=127.0.0.1
PORT=4111
# Docker socket for the docker sandbox, written out in full, e.g. unix:///Users/<you>/.colima/default/docker.sock
DOCKER_HOST=

# --- Origins
# Browser-facing origin of this server, e.g. http://127.0.0.1:4111 or https://factory.example.com
MASTRACODE_PUBLIC_URL=
# Public origin Slack must reach. Leave commented to use MASTRACODE_PUBLIC_URL;
# an empty value turns off "Sign in with Slack" linking.
# MASTRACODE_CHANNELS_PUBLIC_URL=
# Comma-separated cross-origin SPA origins. Only when the UI is hosted elsewhere (needs https).
MASTRACODE_ALLOWED_ORIGINS=

# --- Database (docker-compose.yml)
# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:54329/<POSTGRES_DB>
DATABASE_URL=
# Read by Docker Compose (`npm run db:up`). The password must not contain / $ or #.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Sandbox (sandbox/README.md). Images and ceilings are in sandbox/, not here.
# docker (a container per session on this host) or local. Blank = automatic.
FACTORY_SANDBOX_PROVIDER=
# Clone path inside the container. Default /workspace.
MASTRACODE_SANDBOX_WORKDIR=
# Host folder for local-provider checkouts. Default ~/.mastracode/web/sandboxes.
MASTRACODE_LOCAL_SANDBOX_ROOT=
# Max docker containers at once (default 3) and max concurrent background dispatches.
MASTRACODE_MAX_SANDBOXES=
MASTRACODE_DISPATCH_MAX_IN_FLIGHT=

# --- GitHub
# Comma-separated extra bot logins allowed to trigger work.
MASTRACODE_GITHUB_AUTHORIZED_BOTS=

# --- Studio (patches/)
# The identity Studio shows; nothing is authenticated by these.
MASTRA_STUDIO_USER_ID=
MASTRA_STUDIO_USER_EMAIL=
MASTRA_STUDIO_USER_NAME=
# provider/model id for Studio requests that have no Factory session.
MASTRA_STUDIO_FALLBACK_MODEL=

# --- Model providers — optional; keys can also be stored in the UI (Settings › Models)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- OAuth state signer (second link, after GITHUB_APP_WEBHOOK_SECRET). Keep it if it is set.
WORKOS_COOKIE_PASSWORD=

# --- Deploy login (ops/deploy.sh). A Factory account that administers the organization.
# Read only by the ops scripts, never by the server.
FACTORY_DEPLOY_EMAIL=
FACTORY_DEPLOY_PASSWORD=
# Slack incoming webhook for deploy results (ops/deploy-notify.sh). Empty = no message.
FACTORY_DEPLOY_SLACK_WEBHOOK_URL=

# --- Keep UNSET (AGENTS.md). Each one hands the deployment back to Mastra's
# platform, a cloud sandbox, or turns authentication off.
# NODE_ENV=                      (the LaunchAgent sets it)
# MASTRACODE_AUTH_DISABLED=
# MASTRA_SHARED_API_URL=
# MASTRA_PLATFORM_ACCESS_TOKEN=
# MASTRA_PLATFORM_SECRET_KEY=
# MASTRA_PROJECT_ID=
# MASTRA_ENVIRONMENT_ID=
# E2B_API_KEY=

# ===========================================================================
# 2. ADDITIONAL KEYS — keep these in AWS Parameter Store
# Name each parameter <FACTORY_SSM_PARAMETER_PATH>/<KEY>, e.g.
# /mastra-factory/BETTER_AUTH_SECRET. A value here overrides the parameter, so
# leave them commented once they are in Parameter Store.
# ===========================================================================

# --- Sign-in and stored credentials (README.md)
# Signs session cookies. Keep it stable: changing it ends every session.
# BETTER_AUTH_SECRET=
# Encrypts stored credentials: `openssl rand -base64 32`. Losing it makes them unreadable.
# FACTORY_CREDENTIAL_ENCRYPTION_KEY=
# Id recorded with new ciphertext; change only when rotating. Default v1.
# FACTORY_CREDENTIAL_ENCRYPTION_KEY_ID=
# During rotation: JSON of old keys, e.g. {"v1":"<old-base64-key>"}
# FACTORY_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=

# --- GitHub App (apps/github/README.md) — set all five, or none
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=
# Verifies webhooks and signs OAuth state (first link of the signer chain).
# GITHUB_APP_WEBHOOK_SECRET=

# --- Linear app (apps/linear/README.md) — set both, or none
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=

# --- Slack app (apps/slack/README.md) — the signing secret turns Slack on
# SLACK_APP_SIGNING_SECRET=
# SLACK_APP_BOT_TOKEN=
# SLACK_APP_CLIENT_ID=
# SLACK_APP_CLIENT_SECRET=

# --- Project sandbox secrets are not keys: store them only in Parameter Store as
# <FACTORY_SSM_PARAMETER_PATH>/projects/<owner>/<name>/<NAME> (sandbox/README.md).
