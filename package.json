{
  "name": "mastra-factory",
  "version": "0.1.0",
  "description": "Mastra Factory: an agent-powered software delivery environment. Intake GitHub/Linear issues, work them with coding agents, and ship pull requests — all from your own deployable web app.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "mastra factory dev --dir src/mastra",
    "studio": "mastra studio -p 3000 -h 127.0.0.1 -s 4111",
    "db:up": "docker compose up -d --wait --wait-timeout 120",
    "db:down": "docker compose down",
    "sandbox:build": "sh sandbox/build.sh",
    "check": "tsc --noEmit",
    "test": "vitest run --dir src",
    "build": "mastra build --dir src/mastra && node src/build/complete-output.ts",
    "start": "mastra start",
    "deploy": "mastra deploy"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1151.0",
    "@mastra/auth-better-auth": "1.1.6",
    "@mastra/code-sdk": "1.11.0",
    "@mastra/core": "1.75.0",
    "@mastra/docker": "0.9.0",
    "@mastra/e2b": "0.12.1",
    "@mastra/factory": "0.20.0",
    "@mastra/libsql": "1.25.1",
    "@mastra/loggers": "1.3.2",
    "@mastra/memory": "1.36.0",
    "@mastra/observability": "1.18.4",
    "@mastra/pg": "1.30.0",
    "@mastra/platform-workspace": "1.6.1",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "mastra": "1.33.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.2",
    "vitest": "5.0.1"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^22.19.0 || ^24.0.0",
    "npm": ">=11.17.0"
  }
}
